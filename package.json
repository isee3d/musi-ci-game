{
  "name": "musi-ci-web-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev-o": "pnpm run open-browser && next dev",
    "postinstall": "pnpx prisma generate",
    "lint": "next lint",
    "preview": "next build && next start",
    "start": "next start",
    "db-seed": "prisma db seed",
    "db-clear": "pnpx prisma db push --force-reset",
    "db-update": "pnpm prisma db push && pnpm install && pnpm db-clear && pnpm db-seed",
    "db-init": "prisma db seed",
    "init-repo": " pnpm create-env && pnpm install && pnpm db-update && pnpm db-clear && pnpm db-seed && pnpm dev",
    "typecheck": "tsc --noEmit",
    "open-browser": "start http://localhost:3000",
    "create-env": "node -e \"require('fs').existsSync('.env') || require('fs').copyFileSync('.env.example', '.env');\""
  },
  "prisma": {
    "seed": "tsx prisma/initDB.ts",
    "init": "tsx prisma/initDB.ts"
  },
  "dependencies": {
