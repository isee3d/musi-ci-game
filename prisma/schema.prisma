// https://github.com/chrishoermann/zod-prisma-types

generator zod {
  provider = "zod-prisma-types"
  createRelationValuesTypes        = true
  createOptionalDefaultValuesTypes = true
  writeNullishInModelTypes         = true
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["jsonProtocol"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String           @id @default(cuid())
  name              String?
  email             String?          @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]

  // Own defined fields
  id_restGehoor     Int?
  restGehoor        RestGehoor?       @relation(fields: [id_restGehoor], references: [id], onDelete: Cascade, onUpdate: Cascade)

  id_TypeCI         Int?
  typeCI            TypeCI?           @relation(fields: [id_TypeCI], references: [id], onDelete: Cascade, onUpdate: Cascade)

  role              String?       @default("USER")

  id_Team           Int?
  team              Team?            @relation(fields: [id_Team], references: [id], onDelete: Cascade, onUpdate: Cascade)

  levelResults       LevelResult[]

  hadTraining       Boolean?         @default(false)
  experience        Int?             @default(0)
  processor         String?
  entreeVragenLijst String?
  createdAt         DateTime         @default(now())
}

model RestGehoor {
  id                Int      @id @default(autoincrement())
  user             User[]

  created_at        DateTime        @default(now())
  restGehoor        Int
}

model TypeCI {
  id                Int      @id @default(autoincrement())
  user             User[]

  name            String    @unique
  merk              String
}

model Role {
  id                  Int         @id @default(autoincrement())
  // users               User[]

  name                String         @unique
}

model Kliniek {
  id                  Int        @id @default(autoincrement())
  team                Team[]

  name                String        @unique
}

model Team {
  id                Int         @id @default(autoincrement())
  id_Kliniek        Int?
  kliniek           Kliniek?        @relation(fields: [id_Kliniek], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users             User[]
  game              Game[]

  name              String
  description       String?
}

model Game {
  id                Int         @id @default(autoincrement())
  teams             Team[]
  levels           Level[]

  name              String     @unique
  description       String?
}

model Level{
  id                Int         @id @default(autoincrement())
  name              String      @unique
  description       String?
  id_Game           Int?
  game              Game?      @relation(fields: [id_Game], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subLevels         SubLevel[]
}

model SubLevel {
  id                Int         @id @default(autoincrement())
  levels            Level[]
  fragments         Fragment[]
  gameModes         GameMode[]
  id_levelResult    Int?
  levelResult       LevelResult?  @relation(fields: [id_levelResult], references: [id])

  name              String
  description       String?
  BPM               Int
  correctAnswers    Int
  cooldownTime      Int?
  playTime          Int?
  fragmentToShow    Int
	@@map("SubLevel")
}

model Fragment {
  id                Int         @id @default(autoincrement())
  notes             Note[]
  level           SubLevel[]

  name              String
  description       String?
}

model Note {
  id                Int         @id @default(autoincrement())
  id_Fragment       Int
  fragment          Fragment      @relation(fields: [id_Fragment], references: [id] , onDelete: Cascade, onUpdate: Cascade)

  name              String
  time              Int
  duration          Int
  speed             Int
}

model GameMode {
  id                 Int         @id @default(autoincrement())
  levels            SubLevel[]
  id_levelResult    Int?
  levelResult       LevelResult?   @relation(fields: [id_levelResult], references: [id], onDelete: Cascade, onUpdate: Cascade)

  name               String         @unique
}

model LevelResult {
   id                 Int         @id @default(autoincrement())
   id_User             String
   user                User           @relation(fields: [id_User], references: [id], onDelete: Cascade, onUpdate: Cascade)
   gameModes         GameMode[]
   levels            SubLevel[]
   levelResultFragmentAnswers LevelResultFragmentAnswer[]

    playDate           DateTime
    startTime          DateTime
    endTime            DateTime
    timesListenedAgain Int
    transposed         Int
    reactionTime       Int
}

model LevelResultFragmentAnswer {
   id                 Int         @id @default(autoincrement())
   id_LevelResult      Int
   levelResult         LevelResult    @relation(fields: [id_LevelResult], references: [id], onDelete: Cascade, onUpdate: Cascade)

   answeredCorrectly  Boolean
}
