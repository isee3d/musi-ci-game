// https://github.com/chrishoermann/zod-prisma-types

generator zod {
  provider = "zod-prisma-types"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String           @id @default(cuid())
  name              String?
  email             String?          @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]

  // Own defined fields
  id_restGehoor     String
  restGehoor        RestGehoor?       @relation(fields: [id_restGehoor], references: [id], onDelete: Cascade, onUpdate: Cascade)

  id_TypeCI         String
  typeCI            TypeCI?           @relation(fields: [id_TypeCI], references: [id], onDelete: Cascade, onUpdate: Cascade)

  id_Role           String
  role              Role             @relation(fields: [id_Role], references: [id], onDelete: Cascade, onUpdate: Cascade)

  id_Team           String?
  team              Team?            @relation(fields: [id_Team], references: [id], onDelete: Cascade, onUpdate: Cascade)

  levelResults       LevelResult[]

  hadTraining       Boolean?         @default(false)
  experience        Int?             @default(0)
  processor         String?
  entreeVragenLijst String?
  createdAt         DateTime         @default(now())
}

model RestGehoor {
  id                String      @id @default(cuid())
  users             User[]

  reated_at        DateTime
  restGehoor        Int
}

model TypeCI {
  id                String      @id @default(cuid())
  users             User[]

  ciName            String    @unique
  merk              String
}

model Role {
  id                  String         @id @default(cuid())
  users               User[]

  name                String         @unique
}

model Kliniek {
  id                  String         @id @default(cuid())
  team                Team[]

  name                String        @unique
}

model Team {
  id                String         @id @default(cuid())
  id_Kliniek        String
  kliniek           Kliniek        @relation(fields: [id_Kliniek], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users             User[]
  game              Game[]

  name              String
  description       String
}

model Game {
  id                String         @id @default(cuid())
  teams             Team[]
  levels           Level[]

  name              String
}

model Level {
  id                String         @id @default(cuid())
  id_Game           String
  game              Game      @relation(fields: [id_Game], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fragments         Fragment[]
  gameModes         GameMode[]
  id_levelResult    String
  levelResult       LevelResult   @relation(fields: [id_levelResult], references: [id])

  name              String
  BPM               Int
  description       Int
  correctAnswers    Int
  cooldownTime      Int
  fragmentToShow    Int
}

model Fragment {
  id                String         @id @default(cuid())
  description       String
  notes             Note[]
  levels           Level[]

  name              String
}

model Note {
  id                 String         @id @default(cuid())
  id_Fragment       String
  fragment          Fragment      @relation(fields: [id_Fragment], references: [id] , onDelete: Cascade, onUpdate: Cascade)

  name              String
  time              Int
  duration          Int
  speed             Int
}

model GameMode {
  id                 String         @id @default(cuid())
  levels            Level[]
  id_levelResult    String
  levelResult       LevelResult   @relation(fields: [id_levelResult], references: [id], onDelete: Cascade, onUpdate: Cascade)

  name               String
}

model LevelResult {
   id                 String         @id @default(cuid())
   id_User             String
   user                User           @relation(fields: [id_User], references: [id], onDelete: Cascade, onUpdate: Cascade)
   gameModes         GameMode[]
   levels            Level[]
   levelResultFragmentAnswers LevelResultFragmentAnswer[]

    playDate           DateTime
    startTime          DateTime
    endTime            DateTime
    timesListenedAgain Int
    transposed         Int
    reactionTime       Int
}

model LevelResultFragmentAnswer {
   id                 String         @id @default(cuid())
   id_LevelResult      String
   levelResult         LevelResult    @relation(fields: [id_LevelResult], references: [id], onDelete: Cascade, onUpdate: Cascade)

   answeredCorrectly  Boolean
}
