// https://github.com/chrishoermann/zod-prisma-types

generator zod {
  provider = "zod-prisma-types"
  createRelationValuesTypes        = true
  createOptionalDefaultValuesTypes = true
  writeNullishInModelTypes         = true
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
  // provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String           @id @default(cuid())
  participantId     String?          @unique
  hashedPassword    String?
  name              String?
  email             String?          @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]

  // Own defined fields
  id_restGehoor     Int?
  restGehoor        RestGehoor?       @relation(fields: [id_restGehoor], references: [id], onDelete: Cascade, onUpdate: Cascade)

  id_TypeCI         Int?
  typeCI            TypeCI?           @relation(fields: [id_TypeCI], references: [id], onDelete: Cascade, onUpdate: Cascade)

  role              String?       @default("USER")

  id_Team           Int?
  team              Team?            @relation(fields: [id_Team], references: [id], onDelete: Cascade, onUpdate: Cascade)

  levelResults       LevelResult[]
  questionAnswers    QuestionAnswer[]
  activities         Activity[]

  hadTraining       Boolean?         @default(false)
  experience        Int?             @default(0)
  processor         String?
  entreeVragenLijst String?
  isAllowedToPlay   Boolean?         @default(false)
  preferSkipTutorial Boolean?        @default(false)
  createdAt         DateTime         @default(now())

  @@index([id_restGehoor])
  @@index([id_TypeCI])
  @@index([id_Team])
}

model RestGehoor {
  id                Int      @id @default(autoincrement())
  user             User[]

  created_at        DateTime        @default(now())
  restGehoor        Int
}

model TypeCI {
  id                Int      @id @default(autoincrement())
  user             User[]

  name            String    @unique
  merk              String
}

model Role {
  id                  Int         @id @default(autoincrement())
  // users               User[]

  name                String         @unique
}

model Kliniek {
  id                  Int        @id @default(autoincrement())
  team                Team[]

  name                String        @unique
}

model Team {
  id                Int         @id @default(autoincrement())
  id_Kliniek        Int?
  kliniek           Kliniek?        @relation(fields: [id_Kliniek], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users             User[]
  game              Game[]

  name              String
  description       String?

  @@index([id_Kliniek])
}

model Game {
  id                Int         @id @default(autoincrement())
  teams             Team[]
  levels           Level[]

  name              String     @unique
  description       String?
  color             String?
}

model Level{
  id                Int         @id @default(autoincrement())
  id_Game           Int?
  game              Game?      @relation(fields: [id_Game], references: [id], onDelete: SetNull, onUpdate: SetNull)
  subLevels         SubLevel[]
  levelResult       LevelResult[]

   name              String      @unique
   description       String?
   color             String?
   instrument        String?

   @@index([id_Game])
}

model SubLevel {
  id                Int         @id @default(autoincrement())
  levels            Level[]
  fragments         Fragment[]
  gameModes         GameMode[]
  levelResult       LevelResult[]
  fragmentGroups    FragmentGroup[]

  name              String      @unique
  description       String?
  cooldownTime      Int?
  playTime          Int?
  fragmentToShow    Int
  fragmentToShowLuisteren   Int?
  fragmentToShowSpelen      Int?
  fragmentToShowUitdaging   Int?
  color             String?
  bpm               Int?
}

model FragmentGroup {
  id                Int         @id @default(autoincrement())
  fragments         Fragment[]
  subLevels         SubLevel[]

  name              String
  description       String?
}

model Fragment {
  id                Int         @id @default(autoincrement())
  notes             Note[]
  level             SubLevel[]
  chosenScene       Scene[]     @relation("ChosenFragment")
  playedScene       Scene[]           @relation("PlayedFragment")
  relistenfragment  RelistenFragment[]
  sceneFragment     SceneFragment[]
  fragmentgroup     FragmentGroup[]

  name              String
  isActive          Int         @default(1)
  description       String?
  useAlways         Boolean    @default(false)
}

model Note {
  id                Int         @id @default(autoincrement())
  id_Fragment       Int
  fragment          Fragment      @relation(fields: [id_Fragment], references: [id] , onDelete: Cascade, onUpdate: Cascade)

  name              String
  time              Int
  duration          Int
  speed             Int

  @@index([id_Fragment])
}

model GameMode {
  id                 Int         @id @default(autoincrement())
  levels            SubLevel[]
  levelResult       LevelResult[]
  name               String         @unique
  amountOfScenes     Int?

  one                Int?
  two                Int?
  three              Int?
  go                 Int?
}

model LevelResult {
   id                 Int         @id @default(autoincrement())
   id_User             String
   user                User?           @relation(fields: [id_User], references: [id], onDelete: Cascade, onUpdate: Cascade)
   id_level            Int
   Level              Level?         @relation(fields: [id_level], references: [id], onDelete: Cascade, onUpdate: Cascade)
   id_subLevel         Int
   subLevel           SubLevel?     @relation(fields: [id_subLevel], references: [id], onDelete: Cascade, onUpdate: Cascade)
   id_gameMode         Int
   gameMode           GameMode?      @relation(fields: [id_gameMode], references: [id], onDelete: Cascade, onUpdate: Cascade)
   Scenes             Scene[]

   startTime          DateTime
   endTime            DateTime
   score              Int

   @@index([id_User])
   @@index([id_level])
   @@index([id_subLevel])
   @@index([id_gameMode])
}

model Scene {
  id                    Int         @id @default(autoincrement())
  id_chosenFragment     Int?
  chosenFragment        Fragment?  @relation("ChosenFragment", fields: [id_chosenFragment], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sceneFragments        SceneFragment[]
  id_levelResult        Int?
  levelResult           LevelResult?  @relation(fields: [id_levelResult], references: [id], onDelete: Cascade, onUpdate: Cascade)
  relistenFragments     RelistenFragment[]
  id_playedFragment     Int?
  playedFragment        Fragment?  @relation("PlayedFragment", fields: [id_playedFragment], references: [id], onDelete: Cascade, onUpdate: Cascade)

  chosenFragmentLatency Int?
  answeredCorrectly    Boolean?
  startTime            DateTime?

  @@index([id_chosenFragment])
  @@index([id_levelResult])
  @@index([id_playedFragment])
}

model SceneFragment {
   id                 Int         @id @default(autoincrement())
   id_Scene           Int?
   scene              Scene?         @relation(fields: [id_Scene], references: [id], onDelete: Cascade, onUpdate: Cascade)
   id_fragment        Int
   fragment           Fragment?       @relation(fields: [id_fragment], references: [id])
   fragmentIndex       Int
   groundTone          String
   octave              Int          @default(1)

   @@index([id_Scene])
   @@index([id_fragment])
}

model RelistenFragment {
  id                 Int         @id @default(autoincrement())
  id_fragment        Int
  fragment           Fragment?       @relation(fields: [id_fragment], references: [id])
  id_scene           Int?
  scene              Scene?       @relation(fields: [id_scene], references: [id])

  relistenCount      Int

  @@index([id_fragment])
  @@index([id_scene])
}

model AppSettings {
  id                 Int         @id @default(autoincrement())
  fragmentDotColor    String?     @default("red")
  fragmentDotLineColor String?  @default("black")
}

model QuestionAnswer {
  id                 Int         @id @default(autoincrement())
  id_User            String
  user               User?           @relation(fields: [id_User], references: [id], onDelete: Cascade, onUpdate: Cascade)

  question           String
  answer             String
  answeredDate       DateTime?       @default(now())

  @@index([id_User])
}

model Question {
  id                 Int         @id @default(autoincrement())

  question           String
  answerType         String    @default("TEXT")
}

model Activity {
  id                 Int         @id @default(autoincrement())
  id_User            String
  user               User?           @relation(fields: [id_User], references: [id], onDelete: Cascade, onUpdate: Cascade)

  activity           String
  activity_Date      DateTime       @default(now())

  @@index([id_User])
}
