// https://github.com/chrishoermann/zod-prisma-types

generator zod {
  provider = "zod-prisma-types"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Example {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  levelResults    LevelResult[]
  practiceResults PracticeResult[]
  sceneResults    SceneResult[]
  sessions        Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Level {
  id                   String          @id @default(cuid())
  name                 String
  enablePractice       Boolean
  bpm                  Int
  description          String
  fragmentVisibleCount Int
  duration             Int
  correctAnswers       Int
  cooldownTime         Int
  fragments            LevelFragment[]
}

model LevelFragment {
  levelId    String
  fragmentId String
  fragment   Fragment @relation(fields: [fragmentId], references: [id])
  level      Level    @relation(fields: [levelId], references: [id])

  @@id([levelId, fragmentId])
}

model Fragment {
  id              String                @id @default(cuid())
  name            String
  description     String
  levels          LevelFragment[]
  levelResults    LevelResultFragment[]
  notes           NoteFragment[]
  practiceResults PracticeFragment[]
  sceneResults    SceneFragment[]
}

model Note {
  id        String         @id @default(cuid())
  note      String
  velocity  Int
  time      String
  dur       Int
  fragments NoteFragment[]
}

model NoteFragment {
  noteId     String
  fragmentId String
  fragment   Fragment @relation(fields: [fragmentId], references: [id])
  note       Note     @relation(fields: [noteId], references: [id])

  @@id([noteId, fragmentId])
}

model LevelResultFragment {
  levelResultId String
  fragmentId    String
  fragment      Fragment    @relation(fields: [fragmentId], references: [id])
  levelResult   LevelResult @relation(fields: [levelResultId], references: [id])

  @@id([levelResultId, fragmentId])
}

model PracticeFragment {
  practiceResultId String
  fragmentId       String
  fragment         Fragment       @relation(fields: [fragmentId], references: [id])
  practiceResult   PracticeResult @relation(fields: [practiceResultId], references: [id])

  @@id([practiceResultId, fragmentId])
}

model SceneFragment {
  sceneResultId String
  fragmentId    String
  fragment      Fragment    @relation(fields: [fragmentId], references: [id])
  sceneResult   SceneResult @relation(fields: [sceneResultId], references: [id])

  @@id([sceneResultId, fragmentId])
}

model LevelResult {
  id        String                @id @default(cuid())
  userId    String
  date      DateTime
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragments LevelResultFragment[]
}

model PracticeResult {
  id        String             @id @default(cuid())
  userId    String
  date      DateTime
  fragments PracticeFragment[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SceneResult {
  id         String          @id @default(cuid())
  userId     String
  date       DateTime
  correct    Boolean
  transposed Int
  levelId    String
  fragments  SceneFragment[]
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
